# Copiá este archivo como .env (NO lo subas a GitHub: está en .gitignore).
# Elegí UNA opción de modelo y descomentala.

# --- Opción A: Gemini (tiene capa gratuita: https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
FAST_LLM=google_genai:gemini-2.5-flash
SMART_LLM=google_genai:gemini-2.5-pro
STRATEGIC_LLM=google_genai:gemini-2.5-pro
EMBEDDING=google_genai:models/text-embedding-004

# --- Opción B: OpenAI (pago) ---
# OPENAI_API_KEY=
# FAST_LLM=openai:gpt-5.4-mini
# SMART_LLM=openai:gpt-5.4
# STRATEGIC_LLM=openai:gpt-5.4
# EMBEDDING=openai:text-embedding-3-small

# --- Opción C: 100% gratis y local con Ollama (https://ollama.com) ---
# OLLAMA_BASE_URL=http://localhost:11434
# FAST_LLM=ollama:qwen3:8b
# SMART_LLM=ollama:qwen3:14b
# STRATEGIC_LLM=ollama:qwen3:14b
# EMBEDDING=ollama:nomic-embed-text

# Buscadores sin clave: web (duckduckgo) + académicos (arxiv, openalex, semantic_scholar, pubmed_central)
RETRIEVER=duckduckgo,openalex,semantic_scholar,arxiv
LANGUAGE=spanish
# Opcional, mejores resultados web (1000 búsquedas/mes gratis): https://tavily.com
# TAVILY_API_KEY=
